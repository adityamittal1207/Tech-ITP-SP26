PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/tether
NODE_ENV=development
SMS_DRY_RUN=true

# Firebase Admin — path to service account JSON (relative to server/)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Studio data is scoped to this Firebase UID (demo/seed data owner)
PRIMARY_OWNER_UID=BuwHZGfenUMFrR8LnJZ6kUiIbyk1

# Or inline credentials instead of a file:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
