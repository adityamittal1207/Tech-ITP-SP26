PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/tether
NODE_ENV=development
SMS_DRY_RUN=true

# Firebase Admin — paste from Firebase Console → Project settings → Service accounts
# On Railway: add these three as separate variables (keep quotes on FIREBASE_PRIVATE_KEY)
FIREBASE_PROJECT_ID=tether-455b8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tether-455b8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional fallback: path to service account JSON file (local dev only)
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Studio data is scoped to this Firebase Auth UID
PRIMARY_OWNER_UID=BuwHZGfenUMFrR8LnJZ6kUiIbyk1

TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
# Twilio console → phone number → Messaging → webhook URL (must match exactly for signature check):
# https://your-host/api/webhooks/twilio/sms
TWILIO_WEBHOOK_URL=

# Public booking + cancel magic links (must match where the client is served)
CLIENT_URL=http://localhost:5173
# Optional: separate secret for signed cancel links (defaults to TWILIO_AUTH_TOKEN)
# CANCEL_LINK_SECRET=
STUDIO_TIMEZONE=America/Los_Angeles
